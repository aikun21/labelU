# Directory for the SQLite db (labelu.sqlite) and uploaded media.
# Defaults to the per-user app data dir when unset.
LABELU_DATA_DIR=./data
PASSWORD_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
MEDIA_HOST=http://localhost:8000
# Optional; defaults to sqlite:///<LABELU_DATA_DIR>/labelu.sqlite
# DATABASE_URL=sqlite:///data/labelu.sqlite
